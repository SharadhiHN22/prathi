# Environment Variables Example for Prathi / EditShare
# Copy this file to .env and configure with your local settings.

# PostgreSQL Connection Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prathi
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgresql_password_here

# Application Port
PORT=8085

# Optional Production / Deployment Variables
# APP_BASE_URL=https://your-domain.com
# CORS_ALLOWED_ORIGINS=*
# CLEANUP_CRON=0 */5 * * * *
